{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laix.local/schema/decision-record-v1.json",
  "title": "LAIX Decision Record v1",
  "type": "object",
  "required": ["id", "version", "title", "summary", "decision", "evidence", "approval", "status", "createdAt", "updatedAt", "audit", "undo", "hash"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "const": 1 },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "decision": {
      "type": "object",
      "required": ["text", "confidence"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "rationale": { "type": "string" }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "quote"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string" },
          "quote": { "type": "string", "minLength": 1 },
          "speaker": { "type": "string" },
          "start": { "type": "number" },
          "end": { "type": "number" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "source": { "type": "string" }
        }
      }
    },
    "alternatives": { "type": "array", "items": { "type": "string" } },
    "approval": {
      "type": "object",
      "required": ["required", "state"],
      "properties": {
        "required": { "type": "boolean" },
        "state": { "enum": ["pending", "approved", "rejected"] },
        "by": { "type": "string" },
        "at": { "type": "string", "format": "date-time" },
        "note": { "type": "string" }
      }
    },
    "status": { "enum": ["draft", "approved", "rejected", "executed", "undone"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "audit": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "actor", "action", "detail"],
        "properties": {
          "at": { "type": "string", "format": "date-time" },
          "actor": { "type": "string" },
          "action": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    },
    "undo": {
      "type": "object",
      "required": ["available"],
      "properties": {
        "available": { "type": "boolean" },
        "how": { "type": "string" },
        "at": { "type": "string", "format": "date-time" }
      }
    },
    "metadata": { "type": "object" },
    "hash": { "type": "string", "pattern": "^fnv1a64:[0-9a-f]{16}$" }
  }
}
